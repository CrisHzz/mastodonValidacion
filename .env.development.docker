# Configuración de desarrollo para Docker Compose
# Copia este archivo a .env.development si no existe

# Rails
RAILS_ENV=development
NODE_ENV=development

# Encriptación de ActiveRecord (requerido)
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=fkSxKD2bF396kdQbrP1EJ7WbU7ZgNokR
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=r0hvVmzBVsjxC7AMlwhOzmtc36ZCOS1E
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=PhdFyyfy5xJ7WVd2lWBpcPScRQHzRTNr

# PostgreSQL
DB_HOST=db
DB_USER=postgres
DB_NAME=mastodon_development
DB_PASS=
DB_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CACHE_REDIS_URL=redis://redis:6379/1
SIDEKIQ_REDIS_URL=redis://redis:6379/2

# Elasticsearch (opcional)
ES_ENABLED=true
ES_HOST=es
ES_PORT=9200

# Configuración local
LOCAL_DOMAIN=localhost:3000
LOCAL_HTTPS=false
BIND=0.0.0.0

# Secretos (genera nuevos para producción)
SECRET_KEY_BASE=development_secret_key_base_change_this_in_production
OTP_SECRET=development_otp_secret_change_this_in_production

# SMTP (opcional, para emails en desarrollo)
SMTP_SERVER=localhost
SMTP_PORT=1025
SMTP_LOGIN=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=notifications@localhost:3000

# Almacenamiento de archivos (local por defecto)
# Para S3, descomenta y configura:
# S3_ENABLED=true
# S3_BUCKET=mastodon-dev
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret
# S3_REGION=us-east-1

# Configuración de streaming
STREAMING_CLUSTER_NUM=1
PORT=3000
STREAMING_API_BASE_URL=http://streaming:4000

# Límites y configuración
MAX_TOOT_CHARS=500
SINGLE_USER_MODE=false

# Desarrollo
RAILS_LOG_LEVEL=debug
RAILS_SERVE_STATIC_FILES=true

# Desactivar verificación de host en desarrollo
ALLOWED_PRIVATE_ADDRESSES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# Configuración de Sidekiq
SIDEKIQ_CONCURRENCY=5
